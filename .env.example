# Required
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_TOKEN=ghp_your-token-here

# LLM (LiteLLM reads provider keys from env)
LITELLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Optional
TRIGGER_PHRASE=pls review my code gpt gods
REVIEW_RULES_PATH=rules/review_rules.md
LITELLM_MAX_TOKENS=4096
LITELLM_TEMPERATURE=0.2
MAX_DIFF_TOKENS_PER_CHUNK=6000
MAX_TOTAL_DIFF_TOKENS=100000
MAX_CONCURRENT_CHUNKS=3
MAX_COMMENTS_PER_REVIEW=30
MAX_FILES_DEEP_REVIEW=15
IGNORE_PATTERNS=*.lock,*.min.js,*.min.css,*.generated.*,package-lock.json,yarn.lock,pnpm-lock.yaml
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
